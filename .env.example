# Application
APP_ENV=development
APP_NAME=CIP
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8082
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=6433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=cip_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h

# Security
BCRYPT_COST=12
ENCRYPTION_KEY=change-me-in-production-32-bytes-long

# Paths
MIGRATION_PATH=migrations
SEED_PATH=seeds

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Rate Limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100

# API
API_VERSION=v1
